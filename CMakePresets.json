{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "MSVC Debug (Visual Studio)",
            "description": "Visual Studio 2022, Debug, x64",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build-msvc"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "MSVC Release (Visual Studio)",
            "description": "Visual Studio 2022, Release, x64",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build-msvc"
        },
        {
            "name": "windows-ninja-debug",
            "displayName": "Ninja Debug (CLI)",
            "description": "Ninja generator, Debug, x64",
            "inherits": "windows-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-ninja-release",
            "displayName": "Ninja Release (CLI)",
            "description": "Ninja generator, Release, x64",
            "inherits": "windows-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "displayName": "Build Debug (MSVC)",
            "configurePreset": "windows-msvc-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Build Release (MSVC)",
            "configurePreset": "windows-msvc-release",
            "configuration": "Release"
        },
        {
            "name": "windows-ninja-debug",
            "displayName": "Build Debug (Ninja)",
            "configurePreset": "windows-ninja-debug"
        },
        {
            "name": "windows-ninja-release",
            "displayName": "Build Release (Ninja)",
            "configurePreset": "windows-ninja-release"
        }
    ]
}
