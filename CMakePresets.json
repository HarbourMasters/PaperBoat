{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-windows",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "base-posix",
            "hidden": true,
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-base",
            "hidden": true,
            "inherits": "base-windows",
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clang-cl.cmake"
        },
        {
            "name": "windows-debug",
            "displayName": "Debug (Windows Clang)",
            "description": "Supported Windows build: Ninja + clang-cl, Debug, x64",
            "inherits": "clang-base",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Release (Windows Clang)",
            "description": "Supported Windows build: Ninja + clang-cl, Release, x64",
            "inherits": "clang-base",
            "binaryDir": "${sourceDir}/build/windows-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja-debug",
            "displayName": "Debug (Ninja)",
            "description": "Generic Ninja generator, Debug",
            "inherits": "base-posix",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-release",
            "displayName": "Release (Ninja)",
            "description": "Generic Ninja generator, Release",
            "inherits": "base-posix",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-debug",
            "hidden": true,
            "inherits": "windows-debug"
        },
        {
            "name": "clang-release",
            "hidden": true,
            "inherits": "windows-release"
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "displayName": "Build Debug (Windows Clang)",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "displayName": "Build Release (Windows Clang)",
            "configurePreset": "windows-release"
        },
        {
            "name": "ninja-debug",
            "displayName": "Build Debug (Ninja)",
            "configurePreset": "ninja-debug"
        },
        {
            "name": "ninja-release",
            "displayName": "Build Release (Ninja)",
            "configurePreset": "ninja-release"
        },
        {
            "name": "clang-debug",
            "hidden": true,
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-release",
            "hidden": true,
            "configurePreset": "clang-release"
        }
    ]
}
